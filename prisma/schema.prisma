generator client {
  provider = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- NEXTAUTH SCHEMA ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // RBAC Fields
  role          Role      @default(GENERAL)

  accounts      Account[]
  sessions      Session[]
  departments   Department[]
  
  // CRM Relations
  opportunities Opportunity[] @relation("OpportunityOwner")
  teamOpportunities Opportunity[] @relation("OpportunityTeam")
  quotations    Quotation[]   @relation("QuotationCreator")
  activityLogs  ActivityLog[]
  notes         Note[]
  uploadedAttachments Attachment[]
  
  receivedNotifications Notification[] @relation("ReceivedNotifications")
  sentNotifications     Notification[] @relation("SentNotifications")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastActive    DateTime  @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  MANAGEMENT
  GENERAL
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  recipient   User     @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  
  senderId    String?
  sender      User?    @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  
  type        NotificationType
  title       String
  message     String?  @db.Text
  
  referenceId String?  
  status      NotificationStatus @default(PENDING)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum NotificationType {
  DEAL_TRANSFER_REQUEST
  TEAM_INVITE_REQUEST
  SYSTEM_ALERT
  DEAL_COMMENT
}

enum NotificationStatus {
  PENDING
  ACCEPTED
  REJECTED
  READ
}

model Department {
  id          String @id @default(cuid())
  name        String @unique
  users       User[]
  permissions DepartmentMenuPermission[]
}

// ====== Menu System ======

model MenuItem {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  level       Int
  parentKey   String?
  icon        String?
  href        String?
  description String?  @db.Text
  sortOrder   Int      @default(0)
  isLocked    Boolean  @default(false)

  permissions DepartmentMenuPermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DepartmentMenuPermission {
  id            String   @id @default(cuid())

  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  menuItemId    String
  menuItem      MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  visible       Boolean  @default(false)

  @@unique([departmentId, menuItemId])
}

// --- SYSTEM CONFIG ---
model SystemConfig {
  id    String @id @default("global") // We only need one global config row
  
  // Google OAuth
  googleRefreshToken String? @db.Text
  
  updatedAt DateTime @updatedAt
}

// --- CRM SCHEMA ---

model Company {
  id          String   @id @default(cuid())
  name        String   // Company Name
  address     String?  @db.Text
  country     String?
  
  contacts    Contact[]
  opportunities Opportunity[]
  quotations  Quotation[]
  customPrices CompanyPrice[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contact {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}



enum OpportunityStatus {
  OPEN
  WON
  LOST
  COMPLETED
  CANCELLED
}

enum OpportunityType {
  SALES_DEAL
  INTERNAL_TASK
  PARTNERSHIP
}

model Opportunity {
  id             String            @id @default(cuid())
  type           OpportunityType   @default(SALES_DEAL)
  topic          String            // e.g., "Order 1/26"
  value          Float?            // Amount
  currency       String?           @default("THB")
  
  // Dates
  dueDate        DateTime?
  goodsReadyDate DateTime?
  goodsLoadingDate DateTime?

  // Status & Pipeline
  pipelineStageId String?
  stage          PipelineStage?     @relation(fields: [pipelineStageId], references: [id])
  status         OpportunityStatus  @default(OPEN)
  lossReason     String?            @db.Text
  
  // Custom Fields (Migrated from CSV)
  reserveId      String?
  invoiceId      String?
  attachmentUrl  String?
  closedAt       DateTime?
  quotedAt       DateTime?
  
  // Extra Info
  oemProgress    Int?               // percentage 0-100

  // Relations
  companyId      String?
  company        Company?           @relation(fields: [companyId], references: [id])

  ownerId        String
  owner          User               @relation("OpportunityOwner", fields: [ownerId], references: [id])

  teamMembers    User[]             @relation("OpportunityTeam")

  quotations     Quotation[]
  activityLogs   ActivityLog[]
  notes          Note[]
  tags           OpportunityTag[]
  attachments    Attachment[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([ownerId])
  @@index([status, updatedAt])
  @@index([status, closedAt])
  @@index([companyId])
}

model Attachment {
  id                 String   @id @default(cuid())
  fileName           String
  fileType           String
  size               Int
  
  cloudinaryUrl      String?  @db.Text
  cloudinaryPublicId String?

  googleDriveFileId  String?
  
  opportunityId      String
  opportunity        Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  uploaderId         String
  uploader           User        @relation(fields: [uploaderId], references: [id])

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}



model PipelineStage {
  id            String         @id @default(cuid())
  name          String         // e.g., "In Progress", "To Do"
  order         Int            // For Kanban sorting
  opportunities Opportunity[]
}

enum ActivityLogType {
  COMMENT
  SYSTEM_UPDATE
}

model ActivityLog {
  id            String          @id @default(cuid())
  content       String          @db.Text
  type          ActivityLogType @default(COMMENT)
  
  // Nested Replies (1-level or deep)
  parentId      String?
  parent        ActivityLog?    @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ActivityLog[]   @relation("Replies")

  // Editing state
  isEdited      Boolean         @default(false)
  updatedAt     DateTime        @default(now()) @updatedAt // Tracks edit time
  
  opportunityId String
  opportunity   Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  userId        String
  user          User            @relation(fields: [userId], references: [id])

  createdAt     DateTime        @default(now())

  @@index([opportunityId, parentId, createdAt])
  @@index([opportunityId, type])
  @@index([parentId])
}

model Note {
  id            String       @id @default(cuid())
  content       String       @db.Text
  isPinned      Boolean      @default(false)
  color         String?      
  
  opportunityId String
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  authorId      String
  author        User         @relation(fields: [authorId], references: [id])
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Tag {
  id            String           @id @default(cuid())
  name          String           @unique
  color         String?          // Hex color code
  opportunities OpportunityTag[]
}

model OpportunityTag {
  opportunityId String
  tagId         String
  
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([opportunityId, tagId])
}


// --- PRODUCTS & QUOTATION SCHEMA ---

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?  @db.Text
  basePrice   Float    // Default price
  weight      Float?   // Weight per unit (kg)
  cbm         Float?   // CBM per unit (m3)

  quotationItems QuotationItem[]
  customPrices   CompanyPrice[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// For company-specific pricing
model CompanyPrice {
  id          String   @id @default(cuid())
  price       Float

  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])

  @@unique([productId, companyId])
}

model Quotation {
  id          String   @id @default(cuid())
  quoteNumber String   @unique // e.g., QT-2026-0001
  status      QuoteStatus @default(DRAFT)
  
  totalAmount Float    @default(0)
  totalWeight Float    @default(0)
  totalCBM    Float    @default(0)

  // Relations
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])

  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  creatorId   String
  creator     User     @relation("QuotationCreator", fields: [creatorId], references: [id])

  items       QuotationItem[]

  validUntil  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  INVOICED
}

model QuotationItem {
  id          String   @id @default(cuid())
  quantity    Int
  unitPrice   Float
  discount    Float    @default(0)
  
  // Calculated fields stored for historical record in case product changes
  totalPrice  Float
  totalWeight Float?
  totalCBM    Float?

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  productId   String
  product     Product   @relation(fields: [productId], references: [id])
}
