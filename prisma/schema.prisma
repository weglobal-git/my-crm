generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                    String         @id @default(cuid())
  name                  String?
  email                 String?        @unique
  emailVerified         DateTime?
  image                 String?
  role                  Role           @default(GENERAL)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  lastActive            DateTime       @default(now())
  accounts              Account[]
  activityLogs          ActivityLog[]
  uploadedAttachments   Attachment[]
  notes                 Note[]
  receivedNotifications Notification[] @relation("ReceivedNotifications")
  sentNotifications     Notification[] @relation("SentNotifications")
  opportunities         Opportunity[]  @relation("OpportunityOwner")
  quotations            Quotation[]    @relation("QuotationCreator")
  sessions              Session[]
  departments           Department[]   @relation("DepartmentToUser")
  teamOpportunities     Opportunity[]  @relation("OpportunityTeam")
  contactLogs           ContactLog[]
  companyLogs           CompanyLog[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Notification {
  id          String             @id @default(cuid())
  recipientId String
  senderId    String?
  type        NotificationType
  title       String
  message     String?
  referenceId String?
  status      NotificationStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  recipient   User               @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User?              @relation("SentNotifications", fields: [senderId], references: [id])
}

model Department {
  id          String                     @id @default(cuid())
  name        String                     @unique
  permissions DepartmentMenuPermission[]
  users       User[]                     @relation("DepartmentToUser")
  contacts    Contact[]
}

model MenuItem {
  id          String                     @id @default(cuid())
  key         String                     @unique
  label       String
  level       Int
  parentKey   String?
  icon        String?
  href        String?
  sortOrder   Int                        @default(0)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  description String?
  isLocked    Boolean                    @default(false)
  permissions DepartmentMenuPermission[]
}

model DepartmentMenuPermission {
  id           String     @id @default(cuid())
  departmentId String
  menuItemId   String
  visible      Boolean    @default(false)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([departmentId, menuItemId])
}

model SystemConfig {
  id                 String   @id @default("global")
  googleRefreshToken String?
  updatedAt          DateTime @updatedAt
}

model Company {
  id            String           @id @default(cuid())
  displayName   String?
  name          String
  address       String?
  notes         String?
  country       String?
  type          ContactType      @default(CUSTOMER)
  status        ContactStatus    @default(QUALIFIED)
  starRating    Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  customPrices  CompanyPrice[]
  contacts      Contact[]
  opportunities Opportunity[]
  quotations    Quotation[]
  addresses     CompanyAddress[]
  logs          CompanyLog[]

  @@index([status])
  @@index([starRating])
  @@index([type])
  @@index([status, type, starRating(sort: Desc), createdAt(sort: Desc)])
}

model CompanyAddress {
  id               String       @id @default(cuid())
  companyId        String
  title            String?
  type             AddressType  @default(BILLING)
  isDefault        Boolean      @default(false)
  taxId            String?
  branchNumber     String?
  addressLine1     String
  addressLine2     String?
  subdistrict      String?
  district         String?
  province         String?
  postalCode       String?
  country          String?      @default("Thailand")
  formattedAddress String?
  googleMapsUrl    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Contact {
  id                String        @id @default(cuid())
  name              String
  email             String?
  phone             String?
  role              String?
  contactDepartment String?
  emails            String[]      @default([])
  phones            String[]      @default([])
  isEmailVerified   Boolean       @default(false)
  isPhoneVerified   Boolean       @default(false)
  image             String?
  isActive          Boolean       @default(true)
  type              ContactType   @default(CUSTOMER)
  status            ContactStatus @default(UNQUALIFIED)
  companyId         String
  departmentId      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department        Department?   @relation(fields: [departmentId], references: [id])
  logs         ContactLog[]

  @@index([companyId])
  @@index([departmentId])
  @@index([status])
  @@index([type])
  @@index([isActive])
}

model ContactLog {
  id        String   @id @default(cuid())
  contactId String
  userId    String
  action    String   @default("UPDATE")
  fieldName String?
  oldValue  String?
  newValue  String?
  summary   String
  createdAt DateTime @default(now())

  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([contactId, createdAt])
  @@index([userId])
}

model CompanyLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  action    String   @default("UPDATE")
  fieldName String?
  oldValue  String?
  newValue  String?
  summary   String
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([userId])
}

model Opportunity {
  id               String            @id @default(cuid())
  topic            String
  value            Float?
  currency         String?           @default("THB")
  dueDate          DateTime?
  goodsReadyDate   DateTime?
  goodsLoadingDate DateTime?
  pipelineStageId  String?
  status           OpportunityStatus @default(OPEN)
  lossReason       String?
  oemProgress      Int?
  companyId        String?
  ownerId          String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attachmentUrl    String?
  closedAt         DateTime?
  invoiceId        String?
  quotedAt         DateTime?
  reserveId        String?
  type             OpportunityType   @default(SALES_DEAL)
  activityLogs     ActivityLog[]
  attachments      Attachment[]
  notes            Note[]
  company          Company?          @relation(fields: [companyId], references: [id])
  owner            User              @relation("OpportunityOwner", fields: [ownerId], references: [id])
  stage            PipelineStage?    @relation(fields: [pipelineStageId], references: [id])
  tags             OpportunityTag[]
  quotations       Quotation[]
  teamMembers      User[]            @relation("OpportunityTeam")

  @@index([status])
  @@index([ownerId])
  @@index([status, updatedAt])
  @@index([status, closedAt])
  @@index([companyId])
}

model Attachment {
  id                 String      @id @default(cuid())
  fileName           String
  fileType           String
  size               Int
  cloudinaryUrl      String?
  cloudinaryPublicId String?
  googleDriveFileId  String?
  opportunityId      String
  uploaderId         String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  opportunity        Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  uploader           User        @relation(fields: [uploaderId], references: [id])
}

model PipelineStage {
  id            String        @id @default(cuid())
  name          String
  order         Int
  opportunities Opportunity[]
}

model ActivityLog {
  id            String          @id @default(cuid())
  content       String
  type          ActivityLogType @default(COMMENT)
  opportunityId String
  userId        String
  createdAt     DateTime        @default(now())
  isEdited      Boolean         @default(false)
  parentId      String?
  updatedAt     DateTime        @default(now()) @updatedAt
  opportunity   Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  parent        ActivityLog?    @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ActivityLog[]   @relation("Replies")
  user          User            @relation(fields: [userId], references: [id])

  @@index([opportunityId, parentId, createdAt])
  @@index([opportunityId, type])
  @@index([parentId])
}

model Note {
  id            String      @id @default(cuid())
  content       String
  isPinned      Boolean     @default(false)
  color         String?
  opportunityId String
  authorId      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  author        User        @relation(fields: [authorId], references: [id])
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

model Tag {
  id            String           @id @default(cuid())
  name          String           @unique
  color         String?
  opportunities OpportunityTag[]
}

model OpportunityTag {
  opportunityId String
  tagId         String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([opportunityId, tagId])
}

model Product {
  id             String          @id @default(cuid())
  sku            String          @unique
  name           String
  description    String?
  basePrice      Float
  weight         Float?
  cbm            Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  customPrices   CompanyPrice[]
  quotationItems QuotationItem[]
}

model CompanyPrice {
  id        String  @id @default(cuid())
  price     Float
  productId String
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([productId, companyId])
}

model Quotation {
  id            String          @id @default(cuid())
  quoteNumber   String          @unique
  status        QuoteStatus     @default(DRAFT)
  totalAmount   Float           @default(0)
  totalWeight   Float           @default(0)
  totalCBM      Float           @default(0)
  companyId     String
  opportunityId String?
  creatorId     String
  validUntil    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  company       Company         @relation(fields: [companyId], references: [id])
  creator       User            @relation("QuotationCreator", fields: [creatorId], references: [id])
  opportunity   Opportunity?    @relation(fields: [opportunityId], references: [id])
  items         QuotationItem[]
}

model QuotationItem {
  id          String    @id @default(cuid())
  quantity    Int
  unitPrice   Float
  discount    Float     @default(0)
  totalPrice  Float
  totalWeight Float?
  totalCBM    Float?
  quotationId String
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  MANAGEMENT
  GENERAL
}

enum NotificationType {
  DEAL_TRANSFER_REQUEST
  SYSTEM_ALERT
  TEAM_INVITE_REQUEST
  DEAL_COMMENT
}

enum NotificationStatus {
  PENDING
  ACCEPTED
  REJECTED
  READ
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  COMPLETED
  CANCELLED
}

enum OpportunityType {
  SALES_DEAL
  INTERNAL_TASK
  PARTNERSHIP
}

enum ActivityLogType {
  COMMENT
  SYSTEM_UPDATE
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  INVOICED
}

enum ContactType {
  CUSTOMER
  TRADER
  SHIPPING
  MY_OFFICE
  SUPPLIER
  PARTNER
  OTHER
}

enum ContactStatus {
  QUALIFIED
  UNQUALIFIED
}

enum AddressType {
  BILLING
  SHIPPING
  HEADQUARTERS
  BRANCH
  OTHER
}
