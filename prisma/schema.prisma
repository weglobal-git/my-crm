generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- NEXTAUTH SCHEMA ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // RBAC Fields
  role          Role      @default(GENERAL)
  departmentId  String?

  accounts      Account[]
  sessions      Session[]
  department    Department? @relation(fields: [departmentId], references: [id])
  
  // CRM Relations
  opportunities Opportunity[] @relation("OpportunityOwner")
  teamOpportunities Opportunity[] @relation("OpportunityTeam")
  quotations    Quotation[]   @relation("QuotationCreator")
  activityLogs  ActivityLog[]
  
  receivedNotifications Notification[] @relation("ReceivedNotifications")
  sentNotifications     Notification[] @relation("SentNotifications")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastActive    DateTime  @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  MANAGEMENT
  GENERAL
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  recipient   User     @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  
  senderId    String?
  sender      User?    @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  
  type        NotificationType
  title       String
  message     String?  @db.Text
  
  referenceId String?  
  status      NotificationStatus @default(PENDING)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum NotificationType {
  DEAL_TRANSFER_REQUEST
  TEAM_INVITE_REQUEST
  SYSTEM_ALERT
  DEAL_COMMENT
}

enum NotificationStatus {
  PENDING
  ACCEPTED
  REJECTED
  READ
}

model Department {
  id    String @id @default(cuid())
  name  String @unique
  users User[]
}

// --- CRM SCHEMA ---

model Company {
  id          String   @id @default(cuid())
  name        String   // Company Name
  address     String?  @db.Text
  country     String?
  
  contacts    Contact[]
  opportunities Opportunity[]
  quotations  Quotation[]
  customPrices CompanyPrice[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contact {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum OpportunityType {
  LEAD
  TASK
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  COMPLETED
  CANCELLED
}

model Opportunity {
  id             String            @id @default(cuid())
  type           OpportunityType   @default(LEAD)
  topic          String            // e.g., "Order 1/26"
  value          Float?            // Amount
  currency       String?           @default("THB")
  
  // Dates
  dueDate        DateTime?
  goodsReadyDate DateTime?
  goodsLoadingDate DateTime?

  // Status & Pipeline
  pipelineStageId String?
  stage          PipelineStage?     @relation(fields: [pipelineStageId], references: [id])
  status         OpportunityStatus  @default(OPEN)
  lossReason     String?            @db.Text
  
  // Extra Info
  oemProgress    Int?               // percentage 0-100

  // Relations
  companyId      String?
  company        Company?           @relation(fields: [companyId], references: [id])

  ownerId        String
  owner          User               @relation("OpportunityOwner", fields: [ownerId], references: [id])

  teamMembers    User[]             @relation("OpportunityTeam")

  quotations     Quotation[]
  activityLogs   ActivityLog[]
  tags           OpportunityTag[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum BoardType {
  LEAD
  TASK
}

model PipelineStage {
  id            String         @id @default(cuid())
  name          String         // e.g., "Doing", "Qualified", "Quoted", "Following"
  boardType     BoardType
  order         Int            // For Kanban sorting
  opportunities Opportunity[]
}

enum ActivityLogType {
  COMMENT
  SYSTEM_UPDATE
}

model ActivityLog {
  id            String          @id @default(cuid())
  content       String          @db.Text
  type          ActivityLogType @default(COMMENT)
  
  // Nested Replies (1-level or deep)
  parentId      String?
  parent        ActivityLog?    @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ActivityLog[]   @relation("Replies")

  // Editing state
  isEdited      Boolean         @default(false)
  updatedAt     DateTime        @default(now()) @updatedAt // Tracks edit time
  
  opportunityId String
  opportunity   Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  userId        String
  user          User            @relation(fields: [userId], references: [id])

  createdAt     DateTime        @default(now())
}

model Tag {
  id            String           @id @default(cuid())
  name          String           @unique
  color         String?          // Hex color code
  opportunities OpportunityTag[]
}

model OpportunityTag {
  opportunityId String
  tagId         String
  
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([opportunityId, tagId])
}


// --- PRODUCTS & QUOTATION SCHEMA ---

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?  @db.Text
  basePrice   Float    // Default price
  weight      Float?   // Weight per unit (kg)
  cbm         Float?   // CBM per unit (m3)

  quotationItems QuotationItem[]
  customPrices   CompanyPrice[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// For company-specific pricing
model CompanyPrice {
  id          String   @id @default(cuid())
  price       Float

  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])

  @@unique([productId, companyId])
}

model Quotation {
  id          String   @id @default(cuid())
  quoteNumber String   @unique // e.g., QT-2026-0001
  status      QuoteStatus @default(DRAFT)
  
  totalAmount Float    @default(0)
  totalWeight Float    @default(0)
  totalCBM    Float    @default(0)

  // Relations
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])

  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  creatorId   String
  creator     User     @relation("QuotationCreator", fields: [creatorId], references: [id])

  items       QuotationItem[]

  validUntil  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  INVOICED
}

model QuotationItem {
  id          String   @id @default(cuid())
  quantity    Int
  unitPrice   Float
  discount    Float    @default(0)
  
  // Calculated fields stored for historical record in case product changes
  totalPrice  Float
  totalWeight Float?
  totalCBM    Float?

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  productId   String
  product     Product   @relation(fields: [productId], references: [id])
}
